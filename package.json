  "private": true,
  "description": "Xpert Fintech Ltd. website and admin CMS (internal project name: XPERT NEXUS)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
