# Settings for the Namecheap server. Copy to ~/xpertfintech.env on the server
# (outside the app folder) and fill in. Never commit the real file.
# Most values should be COPIED FROM VERCEL (Settings → Environment Variables → Production)
# so the new server serves the same data and admins can still sign in.

# ── Address ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://xpertfintech.com
# Every other address (www., vercel.app, http://) is sent here.
CANONICAL_HOST=xpertfintech.com
APP_ENV=production

# ── Database (same Neon database as Vercel uses today) ───────────────
DATABASE_URL=
# Neon's direct (non "-pooler") address, for migrations. Optional.
DIRECT_URL=

# ── Admin sign-in: MUST be the same value as on Vercel ───────────────
# A different value switches off every admin's two-factor sign-in.
SESSION_SECRET=
SESSION_IDLE_HOURS=12

# ── Uploaded files: kept in the database (as on Vercel today) ────────
STORAGE_DRIVER=database

# ── Daily backup (cPanel → Cron Jobs calls /api/cron/backup with this) ──
CRON_SECRET=

# ── Email (or set it in Admin → Email & notifications) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Xpert Fintech <no-reply@xpertfintech.com>"
LEAD_ALERT_EMAILS=

# ── Market data, forms, analytics (copy from Vercel) ─────────────────
MARKET_DATA_MODE=none
MARKET_SHARE_API_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Never set on the live site: NEXT_PUBLIC_NOINDEX, EDITOR_HINTS, SEED_ADMIN_PASSWORD
