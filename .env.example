# Copy this file to .env and fill in real values. Never commit .env.
# Separate values are needed for development, staging and production.

# ── App ──────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for canonical URLs, sitemap and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production
APP_ENV=development
# Set to 1 on staging/preview so search engines are told not to index it.
NEXT_PUBLIC_NOINDEX=

# ── Database (PostgreSQL 16+) ────────────────────────────────────────
DATABASE_URL=postgresql://xpert:xpert@localhost:5432/xpert_nexus?schema=public

# ── Admin auth ───────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
# Required for two-factor sign-in (it encrypts the authenticator secrets).
# Changing it later switches off every admin's two-factor sign-in.
SESSION_SECRET=
# Idle timeout for admin sessions, in hours.
SESSION_IDLE_HOURS=12

# First admin account, created by `npm run db:seed` if it does not exist.
# Change the password after first login. Leave empty to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Xpert Admin

# ── Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO…) ─────
# local | s3   (local writes to ./storage — development only)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base URL for served media, if different from the bucket URL.
MEDIA_PUBLIC_BASE_URL=

# ── Email (lead alerts, password resets) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Xpert Fintech <no-reply@xpertfintech.com>"

# ── Market data ──────────────────────────────────────────────────────
# none | exchange | licensed | demo  (see docs/MARKET-DATA.md)
#   exchange: read DSE's and CSE's public pages (once a minute): prices, movers, CSE indices
#             (DSE indices/turnover need the licensed feed — see docs/MARKET-DATA.md)
#   licensed: the feed at MARKET_DATA_API_URL
#   demo:     generated prices for development; refused in production
# Data is shown only after "Show market data on the website" is ticked in Admin → Market data.
MARKET_DATA_MODE=none
ALLOW_DEMO_MARKET_DATA=false
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
# Optional: header to send the raw key in (e.g. X-API-Key). Empty = "Authorization: Bearer <key>".
MARKET_DATA_API_KEY_HEADER=
# Optional overrides for exchange mode
MARKET_DSE_URL=https://www.dse.com.bd/markets
MARKET_CSE_URL=https://www.cse.com.bd/market/current_price
MARKET_CSE_HOME_URL=https://www.cse.com.bd/
# Token for POST /api/market-share (daily market share from Xpert's OMS). 24+ random
# characters, e.g. `openssl rand -hex 24`. Empty = endpoint off.
MARKET_SHARE_API_TOKEN=

# ── Spam protection for public forms (optional) ──────────────────────
# Cloudflare Turnstile. Set both keys to switch it on; without them the forms
# still use a hidden honeypot field, a timing check and a per-IP rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (only after privacy approval) ──────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
