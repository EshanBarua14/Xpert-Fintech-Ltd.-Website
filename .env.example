# Copy this file to .env and fill in real values. Never commit .env.
# Separate values are needed for development, staging and production.

# ── App ──────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for canonical URLs, sitemap and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production
APP_ENV=development
# Set to 1 on staging/preview so search engines are told not to index it.
NEXT_PUBLIC_NOINDEX=

# ── Database (PostgreSQL 16+) ────────────────────────────────────────
DATABASE_URL=postgresql://xpert:xpert@localhost:5432/xpert_nexus?schema=public

# ── Admin auth ───────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Idle timeout for admin sessions, in hours.
SESSION_IDLE_HOURS=12

# First admin account, created by `npm run db:seed` if it does not exist.
# Change the password after first login. Leave empty to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Xpert Admin

# ── Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO…) ─────
# local | s3   (local writes to ./storage — development only)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base URL for served media, if different from the bucket URL.
MEDIA_PUBLIC_BASE_URL=

# ── Email (lead alerts, password resets) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Xpert Fintech <no-reply@xpertfintech.com>"

# ── Market data ──────────────────────────────────────────────────────
# demo | licensed | none. Production refuses to start with "demo"
# unless ALLOW_DEMO_MARKET_DATA=true is set explicitly.
MARKET_DATA_MODE=none
ALLOW_DEMO_MARKET_DATA=false
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# ── Spam protection for public forms (optional) ──────────────────────
# Cloudflare Turnstile. Set both keys to switch it on; without them the forms
# still use a hidden honeypot field, a timing check and a per-IP rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (only after privacy approval) ──────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
